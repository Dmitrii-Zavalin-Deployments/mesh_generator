{
  "$id": "mesh_generator_results_schema.json",
  "title": "Mesh Generator Results Schema",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "results": {
      "type": "object",
      "description": "CFD-ready domain representation: grid extents, resolution, mask, and boundary conditions.",
      "additionalProperties": false,

      "properties": {

        "grid": {
          "type": "object",
          "description": "Structured grid extents and resolution for Navier–Stokes solver.",
          "additionalProperties": false,
          "properties": {
            "x_min": { "type": "number" },
            "x_max": { "type": "number" },
            "y_min": { "type": "number" },
            "y_max": { "type": "number" },
            "z_min": { "type": "number" },
            "z_max": { "type": "number" },
            "nx": { "type": "integer", "minimum": 1 },
            "ny": { "type": "integer", "minimum": 1 },
            "nz": { "type": "integer", "minimum": 1 }
          },
          "required": [
            "x_min", "x_max",
            "y_min", "y_max",
            "z_min", "z_max",
            "nx", "ny", "nz"
          ]
        },

        "mask": {
          "type": "array",
          "description": "Solid/fluid mask for Navier–Stokes solver. Canonical flattening: i + nx*(j + ny*k).",
          "items": {
            "type": "integer",
            "enum": [-1, 0, 1]
          }
        },

        "boundary_conditions": {
          "type": "array",
          "description": "Boundary condition locations and types derived from geometry.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "location": {
                "type": "string",
                "enum": [
                  "x_min", "x_max",
                  "y_min", "y_max",
                  "z_min", "z_max",
                  "wall"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "no-slip",
                  "free-slip",
                  "inflow",
                  "outflow",
                  "pressure"
                ]
              },
              "surface_id": {
                "type": "string",
                "description": "Identifier of the originating geometric surface."
              }
            },
            "required": ["location", "type"]
          }
        }
      },

      "required": ["grid", "mask", "boundary_conditions"]
    }
  },

  "required": ["results"]
}